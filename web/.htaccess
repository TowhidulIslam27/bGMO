# bGMO — Bangladesh Ground Motion Observatory
DirectoryIndex index.html

# Correct types for the data files
AddType application/json .json
AddType application/geo+json .geojson
AddType text/plain .txt

# Compress text and data (the point and time-series files shrink a lot)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/geo+json image/svg+xml
</IfModule>

# Browser caching: data and images rarely change; the page itself is revalidated
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/plain "access plus 30 days"
  ExpiresByType application/json "access plus 1 day"
  ExpiresByType application/geo+json "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
</IfModule>

# Force HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

Options -Indexes
